{
  "name": "inventory-wms-server",
  "version": "1.0.0",
  "description": "Scan-driven, transaction-based inventory, QC and assembly traceability server",
  "main": "src/index.js",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node src/scripts/seed.js",
    "migrate": "node src/scripts/migrateLegacy.js",
    "test": "node --require ./test/helpers/setup.js --test --test-concurrency=1 test/*.test.js",
    "test:unit": "node --require ./test/helpers/setup.js --test --test-concurrency=1 test/*.unit.test.js",
    "test:integration": "node --require ./test/helpers/setup.js --test --test-concurrency=1 test/features.test.js test/gatepass.test.js test/hardening.test.js test/rack.integration.test.js test/v4.integration.test.js test/v5.integration.test.js",
    "test:ci": "npm test",
    "mongo:start": "docker compose up -d mongo",
    "mongo:stop": "docker compose stop mongo",
    "mongo:logs": "docker compose logs -f mongo",
    "docs": "node src/scripts/apidocs.js",
    "reconcile": "node src/scripts/reconcile.js",
    "load:assets": "node src/scripts/loadAssets.js",
    "cleanup:bom": "node src/scripts/cleanupTempBom.js"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
